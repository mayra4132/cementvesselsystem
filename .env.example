# =============================================================================
# VIGOR Smart Port Operations - Environment Configuration Template
# For deployment to Vercel (Frontend & Serverless API) + cPanel MySQL Database
# =============================================================================

# --- cPanel MySQL Database Credentials ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# --- Enterprise Authentication & Security ---
# Secret key used for HMAC-SHA256 signature verification of corporate sessions
SESSION_SECRET=

# --- Gemini Operations Intelligence Assistant ---
# Server-side API key for grounded decision assistance
GEMINI_API_KEY=

# --- Client Frontend Configuration (Vite) ---
# Set to /api/v1 by default for unified Express/Vercel serverless routing
VITE_API_URL=/api/v1

# Set to false in production to query the cPanel MySQL database
VITE_USE_MOCK_API=false